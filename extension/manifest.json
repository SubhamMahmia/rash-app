{
  "manifest_version": 3,
  "name": "RaSh Ambient Capture",
  "version": "1.0",
  "description": "RaSh: private, local text memory with an ON/OFF switch. No screenshots.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}